_ids_csv": "324904154,324904155", "scores_csv": "1-3"}}, {"match": {"id": 324904157, "tournament_id": 13095399, "state": "complete", "player1_id": 204573053, "player2_id": 204573047, "player1_prereq_match_id": 324904154, "player2_prereq_match_id": 324904155, "player1_is_prereq_match_loser": true, "player2_is_prereq_match_loser": true, "winner_id": 204573047, "loser_id": 204573053, "started_at": "2023-06-25T13:27:38.356-04:00", "created_at": "2023-06-24T09:03:28.662-04:00", "updated_at": "2023-06-25T13:27:50.044-04:00", "identifier": "3P", "has_attachment": false, "round": 0, "player1_votes": null, "player2_votes": null, "group_id": null, "attachment_count": null, "scheduled_time": null, "location": null, "underway_at": null, "optional": null, "completed_at": "2023-06-25T13:27:50.049-04:00", "suggested_play_order": null, "forfeited": null, "open_graph_image_file_name": null, "open_graph_image_content_type": null, "open_graph_image_file_size": null, "metadata": null, "player1_metadata": null, "player2_metadata": null, "prerequisite_match_ids_csv": "324904154,324904155", "scores_csv": "2-3"}}], "description_source": "<h1>CARDS FROM THE BROTHERS IN ARMS SET ARE NOT PERMITTED IN THE OPEN. IF YOUR DECK CONTAINS A CARD FROM THE BROTHERS IN ARMS PRE-RELEASE, YOU WILL BE DISQUALIFIED.</h1><p></p><hr><p style=\"margin-bottom: 1.6rem;\">STAGE TWO\u00a0- If you finish in the Top 8 from either stage weekend, you will be qualified for the next stage - Saturday, June 24th to compete in the single elimination best of 5 conquest.\u00a0\u00a0In the top 16, participants play a Single Elimination bracket with closed deck lists in a best of 5 series. However, each win must be with a deck from a different main nation.</p><p>STAGE THREE\u00a0- In the top 4, players submit 4 decks from different main nations and continue to play a Single Elimination bracket, in a best of 5 series, on Sunday June 25th. This final part of the Open is played with open deck lists.</p><p><span style='color: rgb(255, 255, 255); font-family: \"Chakra Petch\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Oxygen, Ubuntu, Cantarell, \"Fira Sans\", \"Droid Sans\", \"Helvetica Neue\", sans-serif; font-size: 18px; font-weight: 700; letter-spacing: 0.01em;'><br>PRIZE POOL</span><br></p><p>1st: $600 USD<br>2nd: $450 USD<br>3rd: $250 USD<br>4th: $200 USD<br>5th-8th: 500 Diamonds and 2000 Gold<br>9th-16th: 200 Diamonds and 1000 Gold<br></p><h4>FORMAT &amp; SCHEDULE</h4><p style=\"margin-bottom: 1.6rem;\">Top Cuts</p><ul>\r\n<li><p>Bring four decks from four different main nations</p></li>\r\n<li><p>Top 16 conquest format best of 5 with closed deck lists</p></li>\r\n<li><p>Top 16 Bracket June 24th\u00a0@ 1300 GMT<br></p></li>\r\n<li><p>Top 4 Bracket &amp; Live Stream June 25th @ 1300 GMT</p></li>\r\n</ul><p style=\"margin-bottom: 1.6rem;\">Kards Open Full Rules and Regulations:\u00a0<a href=\"https://docs.google.com/document/d/1_uYNermUzVIdr4K9RwrAI2mKhDlQTWp-oKqRzRA8iso/edit?usp=sharing\" target=\"_blank\" rel=\"nofollow\">https://support.kards.com/hc/en-us/articles/8712237212697-KARDS-Tournament-Official-Rules</a></p><ul>\r\n<li><p>The Kards Esports Discord will be the main hub of communication with the tournament admins. This is the required method for contacting an admin if you have questions or a match dispute:\u00a0<a href=\"https://discord.gg/288DQexmng\" target=\"_blank\" rel=\"nofollow\">https://discord.gg/288DQexmng</a></p></li>\r\n<li><p>For Chinese players who can not access Discord, there is a Wechat group for tournament communication. Contact: 003546614978</p></li>\r\n</ul>", "subdomain": null, "full_challonge_url": "https://challonge.com/ddnhb22k", "live_image_url": "https://challonge.com/ddnhb22k.svg", "sign_up_url": null, "review_before_finalizing": true, "accepting_predictions": false, "participants_locked": true, "game_name": "Kards: The World War II Collectible Card Game", "participants_swappable": false, "team_convertable": false, "group_stages_were_started": false}, "kards_meta": {"url": "https://challonge.com/ddnhb22k", "title": "Kards Open XVI - Top 16", "category": "open", "event": "", "stage": ""}}