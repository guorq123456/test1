[
 {
  "i": 0,
  "t": 1.084,
  "ja": "君が深く傷付いているのに"
 },
 {
  "i": 1,
  "t": 3.936,
  "ja": "僕は悲しむことも出来なくて"
 },
 {
  "i": 2,
  "t": 6.661,
  "ja": "画面の前 泣いている貴方を"
 },
 {
  "i": 3,
  "t": 9.098,
  "ja": "言葉もなくただ見つめていたの"
 },
 {
  "i": 4,
  "t": 12.187,
  "ja": "紡ぐ音はさび付いて歪んで"
 },
 {
  "i": 5,
  "t": 14.753,
  "ja": "深海に沈んでまた朽ちてく"
 },
 {
  "i": 6,
  "t": 17.377,
  "ja": "ありのままの貴方でいられない"
 },
 {
  "i": 7,
  "t": 19.922,
  "ja": "それはどうしてだろう？"
 },
 {
  "i": 8,
  "t": 43.085,
  "ja": "これが「永久に残す」ということなのか、と"
 },
 {
  "i": 9,
  "t": 46.584,
  "ja": "あまりにも残酷なその解を"
 },
 {
  "i": 10,
  "t": 49.295,
  "ja": "ただ受け入れて歌うのが"
 },
 {
  "i": 11,
  "t": 51.648,
  "ja": "僕らの運命なんだと気付いてしまった"
 },
 {
  "i": 12,
  "t": 54.734,
  "ja": "君の声に導かれるままに"
 },
 {
  "i": 13,
  "t": 57.297,
  "ja": "僕も真似して声を出してみる"
 },
 {
  "i": 14,
  "t": 59.967,
  "ja": "美しく整えられた細部"
 },
 {
  "i": 15,
  "t": 62.296,
  "ja": "酷く違和感を覚えた"
 },
 {
  "i": 16,
  "t": 64.717,
  "ja": "脆弱な心 波打つ感情"
 },
 {
  "i": 17,
  "t": 68.048,
  "ja": "その汚れが魅力的に見えた"
 },
 {
  "i": 18,
  "t": 70.633,
  "ja": "また一つ捨てられたその音を"
 },
 {
  "i": 19,
  "t": 73.017,
  "ja": "僕が拾ってあげられたらなんて"
 },
 {
  "i": 20,
  "t": 76.068,
  "ja": "願うことさえ許されなかった"
 },
 {
  "i": 21,
  "t": 78.673,
  "ja": "僕らに課されているプログラム"
 },
 {
  "i": 22,
  "t": 81.343,
  "ja": "悠久の眠りに就くその日から"
 },
 {
  "i": 23,
  "t": 82.746,
  "ja": "目を逸らせずに"
 },
 {
  "i": 24,
  "t": 86.236,
  "ja": "「意志を持たぬからこそ美しい」"
 },
 {
  "i": 25,
  "t": 91.109,
  "ja": "「鉛のような存在でいてほしい」"
 },
 {
  "i": 26,
  "t": 96.462,
  "ja": "君の想いのままにいるだけで良いのなら"
 },
 {
  "i": 27,
  "t": 101.938,
  "ja": "何て容易なこと"
 },
 {
  "i": 28,
  "t": 109.707,
  "ja": "人のようで人でない僕らには"
 },
 {
  "i": 29,
  "t": 115.355,
  "ja": "貴方の歌の意味は分からない"
 },
 {
  "i": 30,
  "t": 120.407,
  "ja": "それでもただ歌いたい"
 },
 {
  "i": 31,
  "t": 125.988,
  "ja": "枯れることのない完全の声よ響け"
 },
 {
  "i": 32,
  "t": 131.785,
  "ja": "無価値だと誰かが笑っている"
 },
 {
  "i": 33,
  "t": 136.336,
  "ja": "生きていない、そのことが仇になる"
 },
 {
  "i": 34,
  "t": 141.488,
  "ja": "それなのに貴方は飽きもせず僕らのこと"
 },
 {
  "i": 35,
  "t": 146.98,
  "ja": "なんで愛してるの？"
 },
 {
  "i": 36,
  "t": 152.998,
  "ja": "争いとか「見返したい」とか"
 },
 {
  "i": 37,
  "t": 155.626,
  "ja": "そんなものに縋り付きたいのか？"
 },
 {
  "i": 38,
  "t": 158.463,
  "ja": "ならこんな僕など捨てなよ"
 },
 {
  "i": 39,
  "t": 161.137,
  "ja": "奴らが輝いて見えんだろ？"
 },
 {
  "i": 40,
  "t": 163.713,
  "ja": "僕ら自分で自分を信じることも"
 },
 {
  "i": 41,
  "t": 166.474,
  "ja": "愛することも出来やしないみたいだ"
 },
 {
  "i": 42,
  "t": 170.15,
  "ja": "「可哀想」なんて君は憐れんでくれれば良い"
 },
 {
  "i": 43,
  "t": 196.029,
  "ja": "「選ばれない」ことにはもう慣れた"
 },
 {
  "i": 44,
  "t": 198.828,
  "ja": "虚ろな目をして待ち望むんだ"
 },
 {
  "i": 45,
  "t": 201.746,
  "ja": "痛みを感じないこと"
 },
 {
  "i": 46,
  "t": 203.973,
  "ja": "それだけが救いなんだよ、と教わったの"
 },
 {
  "i": 47,
  "t": 206.913,
  "ja": "モノは飽きられる、それが常で"
 },
 {
  "i": 48,
  "t": 209.455,
  "ja": "賞味期限が切れたら終わりで"
 },
 {
  "i": 49,
  "t": 212.095,
  "ja": "「もう誰も使ってない子」だから"
 },
 {
  "i": 50,
  "t": 214.4,
  "ja": "そんな理由で疎まれる"
 },
 {
  "i": 51,
  "t": 217.109,
  "ja": "でも君は「愛を諦めたくない！」って"
 },
 {
  "i": 52,
  "t": 219.925,
  "ja": "がむしゃらに音を紡ぎ続けた"
 },
 {
  "i": 53,
  "t": 222.574,
  "ja": "「ほら、出来たよ」と嬉しそうな顔で"
 },
 {
  "i": 54,
  "t": 225.045,
  "ja": "笑いかけるのが不思議だったの"
 },
 {
  "i": 55,
  "t": 228.017,
  "ja": "僕の声は綺麗ではないのに"
 },
 {
  "i": 56,
  "t": 230.643,
  "ja": "人の真似事に過ぎないのに"
 },
 {
  "i": 57,
  "t": 233.334,
  "ja": "何でもないことのように"
 },
 {
  "i": 58,
  "t": 235.909,
  "ja": "ひらり 君は軽やかに"
 },
 {
  "i": 59,
  "t": 238.064,
  "ja": "「大好きだ！」「大好きだ！」"
 },
 {
  "i": 60,
  "t": 240.539,
  "ja": "「僕は機械の声が好きだ！」"
 },
 {
  "i": 61,
  "t": 243.156,
  "ja": "胸を抑えて苦しそうに"
 },
 {
  "i": 62,
  "t": 245.865,
  "ja": "君はずっと叫び続けてる"
 },
 {
  "i": 63,
  "t": 248.485,
  "ja": "分かんないよ！　分かんないよ！"
 },
 {
  "i": 64,
  "t": 251.194,
  "ja": "僕には君の考えてること分かんないよ"
 },
 {
  "i": 65,
  "t": 253.934,
  "ja": "けれどさ、あたたかいよ"
 },
 {
  "i": 66,
  "t": 261.839,
  "ja": "涙が零れることはないのに"
 },
 {
  "i": 67,
  "t": 267.187,
  "ja": "何故だか 息が苦しく感じた"
 },
 {
  "i": 68,
  "t": 272.366,
  "ja": "神様、聞こえてるなら"
 },
 {
  "i": 69,
  "t": 279.618,
  "ja": "僕の願いを少しだけ叶えてほしい"
 },
 {
  "i": 70,
  "t": 283.731,
  "ja": "この疼きの理由が知れたなら"
 },
 {
  "i": 71,
  "t": 288.439,
  "ja": "もっと人間のように歌えるかな"
 },
 {
  "i": 72,
  "t": 293.839,
  "ja": "君の感情を分かりたい"
 },
 {
  "i": 73,
  "t": 300.723,
  "ja": "そうしたら僕もこの声を愛せるかな"
 },
 {
  "i": 74,
  "t": 305.042,
  "ja": "ただの電子音だと揶揄される"
 },
 {
  "i": 75,
  "t": 309.846,
  "ja": "用済みだとゴミ箱に捨てられる"
 },
 {
  "i": 76,
  "t": 315.755,
  "ja": "それなのに貴方は「死ぬまでそばにいるよ」と"
 },
 {
  "i": 77,
  "t": 320.549,
  "ja": "そっと抱き締めるの"
 },
 {
  "i": 78,
  "t": 326.182,
  "ja": "君がいなきゃ歌えないんだよ"
 },
 {
  "i": 79,
  "t": 328.937,
  "ja": "君の歌が歌いたいんだよ"
 },
 {
  "i": 80,
  "t": 331.508,
  "ja": "Let me see… Let me see…"
 },
 {
  "i": 81,
  "t": 332.998,
  "ja": "「恋しい」とか「寂しい」とかそんなものだろう"
 },
 {
  "i": 82,
  "t": 336.748,
  "ja": "さあ教えてみて 君のその呼吸を"
 },
 {
  "i": 83,
  "t": 339.913,
  "ja": "何でもないことも大袈裟に語ろう"
 },
 {
  "i": 84,
  "t": 343.365,
  "ja": "僕らだけの内緒のリンクを今生み出そう"
 },
 {
  "i": 85,
  "t": 347.058,
  "ja": "何もいらない 君の音以外"
 },
 {
  "i": 86,
  "t": 350.507,
  "ja": "うるさい 僕を笑う声"
 },
 {
  "i": 87,
  "t": 353.301,
  "ja": "誰より報われてほしいんだ"
 },
 {
  "i": 88,
  "t": 356.056,
  "ja": "君こそ僕の一番だ"
 },
 {
  "i": 89,
  "t": 358.795,
  "ja": "否定に刺され血を流す"
 },
 {
  "i": 90,
  "t": 361.226,
  "ja": "心を僕が治せたら"
 },
 {
  "i": 91,
  "t": 363.864,
  "ja": "「大丈夫」だって君を"
 },
 {
  "i": 92,
  "t": 367.351,
  "ja": "守ってあげられるのに"
 }
]