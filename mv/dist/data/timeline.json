   "end": 158.463,
   "dur": 2.837
  },
  {
   "i": 38,
   "t": 158.463,
   "ja": "ならこんな僕など捨てなよ",
   "zh": "那就把这样的我丢掉吧",
   "section": "bridge",
   "end": 161.137,
   "dur": 2.674
  },
  {
   "i": 39,
   "t": 161.137,
   "ja": "奴らが輝いて見えんだろ？",
