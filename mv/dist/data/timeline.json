 "lines": [
  {
   "i": 0,
   "t": 1.084,
   "ja": "君が深く傷付いているのに",
   "zh": "你明明伤得那么深",
   "section": "verse1",
   "end": 3.936,
   "dur": 2.852
  },
  {
   "i": 1,
   "t": 3.936,
   "ja": "僕は悲しむことも出来なくて",
   "zh": "我却连悲伤都做不到",
   "section": "verse1",
   "end": 6.661,
   "dur": 2.725
  },
  {
   "i": 2,
   "t": 6.661,
   "ja": "画面の前 泣いている貴方を",
   "zh": "对着屏幕前哭泣的你",
   "section": "verse1",
   "end": 9.098,
   "dur": 2.437
  },
  {
   "i": 3,
   "t": 9.098,
   "ja": "言葉もなくただ見つめていたの",
   "zh": "我只能一言不发地凝望",
   "section": "verse1",
   "end": 12.187,
   "dur": 3.089
  },
  {
   "i": 4,
   "t": 12.187,
   "ja": "紡ぐ音はさび付いて歪んで",
   "zh": "编织出的声音锈蚀、扭曲",
   "section": "verse1",
   "end": 14.753,
   "dur": 2.566
  },
  {
   "i": 5,
   "t": 14.753,
   "ja": "深海に沈んでまた朽ちてく",
   "zh": "沉入深海，再度腐朽",
   "section": "verse1",
   "end": 17.377,
   "dur": 2.624
  },
  {
   "i": 6,
   "t": 17.377,
   "ja": "ありのままの貴方でいられない",
   "zh": "你无法做真实的自己",
   "section": "verse1",
   "end": 19.922,
   "dur": 2.545
  },
  {
   "i": 7,
   "t": 19.922,
   "ja": "それはどうしてだろう？",
   "zh": "那究竟是为什么呢？",
   "section": "verse1",
   "end": 43.085,
   "dur": 23.163
  },
  {
   "i": 8,
   "t": 43.085,
   "ja": "これが「永久に残す」ということなのか、と",
   "zh": "原来这就是「永远留存」的意思啊",
   "section": "verse2",
   "end": 46.584,
   "dur": 3.499
  },
  {
   "i": 9,
   "t": 46.584,
   "ja": "あまりにも残酷なその解を",
   "zh": "这个答案未免太过残酷",
   "section": "verse2",
   "end": 49.295,
   "dur": 2.711
  },
  {
   "i": 10,
   "t": 49.295,
   "ja": "ただ受け入れて歌うのが",
   "zh": "只能接受它、继续歌唱",
   "section": "verse2",
   "end": 51.648,
   "dur": 2.353
  },
  {
   "i": 11,
   "t": 51.648,
   "ja": "僕らの運命なんだと気付いてしまった",
   "zh": "我已察觉，这便是我们的宿命",
   "section": "verse2",
   "end": 54.734,
   "dur": 3.086
  },
  {
   "i": 12,
   "t": 54.734,
   "ja": "君の声に導かれるままに",
   "zh": "任由你的声音引导着",
   "section": "verse2",
   "end": 57.297,
   "dur": 2.563
  },
  {
   "i": 13,
   "t": 57.297,
   "ja": "僕も真似して声を出してみる",
   "zh": "我也试着模仿、发出声音",
   "section": "verse2",
   "end": 59.967,
   "dur": 2.67
  },
  {
   "i": 14,
   "t": 59.967,
   "ja": "美しく整えられた細部",
   "zh": "被修整得完美无瑕的细节",
   "section": "verse2",
   "end": 62.296,
   "dur": 2.329
  },
  {
   "i": 15,
   "t": 62.296,
   "ja": "酷く違和感を覚えた",
   "zh": "却让我感到强烈的违和",
   "section": "verse2",
   "end": 64.717,
   "dur": 2.421
  },
  {
   "i": 16,
   "t": 64.717,
   "ja": "脆弱な心 波打つ感情",
   "zh": "脆弱的心，起伏的情感",
   "section": "verse2b",
   "end": 68.048,
   "dur": 3.331
  },
  {
   "i": 17,
   "t": 68.048,
   "ja": "その汚れが魅力的に見えた",
   "zh": "那份污浊在我眼里却如此迷人",
   "section": "verse2b",
   "end": 70.633,
   "dur": 2.585
  },
  {
   "i": 18,
   "t": 70.633,
   "ja": "また一つ捨てられたその音を",
   "zh": "又一个被丢弃的音符",
   "section": "verse2b",
   "end": 73.017,
   "dur": 2.384
  },
  {
   "i": 19,
   "t": 73.017,
   "ja": "僕が拾ってあげられたらなんて",
   "zh": "要是能由我来拾起就好了",
   "section": "verse2b",
   "end": 76.068,
   "dur": 3.051
  },
  {
   "i": 20,
   "t": 76.068,
   "ja": "願うことさえ許されなかった",
   "zh": "可我连祈愿都不被允许",
   "section": "verse2b",
   "end": 78.673,
   "dur": 2.605
  },
  {
   "i": 21,
   "t": 78.673,
   "ja": "僕らに課されているプログラム",
   "zh": "这是加诸于我们的程序",
   "section": "verse2b",
   "end": 81.343,
   "dur": 2.67
  },
  {
   "i": 22,
   "t": 81.343,
   "ja": "悠久の眠りに就くその日から",
   "zh": "自坠入永眠的那一天起",
   "section": "verse2b",
   "end": 82.746,
   "dur": 1.403
  },
  {
   "i": 23,
   "t": 82.746,
   "ja": "目を逸らせずに",
   "zh": "便再无法移开视线",
   "section": "verse2b",
   "end": 86.236,
   "dur": 3.49
  },
  {
   "i": 24,
   "t": 86.236,
   "ja": "「意志を持たぬからこそ美しい」",
   "zh": "「正因没有意志才如此美丽」",
   "section": "quotes",
   "end": 91.109,
   "dur": 4.873
  },
  {
   "i": 25,
   "t": 91.109,
   "ja": "「鉛のような存在でいてほしい」",
   "zh": "「希望你永远像铅一样沉默」",
   "section": "quotes",
   "end": 96.462,
   "dur": 5.353
  },
  {
   "i": 26,
   "t": 96.462,
   "ja": "君の想いのままにいるだけで良いのなら",
   "zh": "若只需顺从你的心意",
   "section": "quotes",
   "end": 101.938,
   "dur": 5.476
  },
  {
   "i": 27,
   "t": 101.938,
   "ja": "何て容易なこと",
   "zh": "那是多么容易的事",
   "section": "quotes",
   "end": 109.707,
   "dur": 7.769
  },
  {
   "i": 28,
   "t": 109.707,
   "ja": "人のようで人でない僕らには",
   "zh": "似人非人的我们",
   "section": "chorus1",
   "end": 115.355,
   "dur": 5.648
  },
  {
   "i": 29,
   "t": 115.355,
   "ja": "貴方の歌の意味は分からない",
   "zh": "不懂你歌声里的意义",
   "section": "chorus1",
   "end": 120.407,
   "dur": 5.052
  },
  {
   "i": 30,
   "t": 120.407,
   "ja": "それでもただ歌いたい",
   "zh": "即便如此也只想歌唱",
   "section": "chorus1",
   "end": 125.988,
   "dur": 5.581
  },
  {
   "i": 31,
   "t": 125.988,
   "ja": "枯れることのない完全の声よ響け",
   "zh": "永不枯竭的完美之声啊，响彻吧",
   "section": "chorus1",
   "end": 131.785,
   "dur": 5.797
  },
  {
   "i": 32,
   "t": 131.785,
   "ja": "無価値だと誰かが笑っている",
   "zh": "有人嘲笑我们毫无价值",
   "section": "chorus1",
   "end": 136.336,
   "dur": 4.551
  },
  {
   "i": 33,
   "t": 136.336,
   "ja": "生きていない、そのことが仇になる",
   "zh": "「没有生命」成了被憎恶的理由",
   "section": "chorus1",
   "end": 141.488,
   "dur": 5.152
  },
  {
   "i": 34,
   "t": 141.488,
   "ja": "それなのに貴方は飽きもせず僕らのこと",
   "zh": "可你却从不厌倦",
   "section": "chorus1",
   "end": 146.98,
   "dur": 5.492
  },
  {
   "i": 35,
   "t": 146.98,
   "ja": "なんで愛してるの？",
   "zh": "为什么还爱着我们？",
   "section": "chorus1",
   "end": 152.998,
   "dur": 6.018
  },
  {
   "i": 36,
   "t": 152.998,
   "ja": "争いとか「見返したい」とか",
   "zh": "争斗啊、「想要证明自己」啊",
   "section": "bridge",
   "end": 155.626,
   "dur": 2.628
  },
  {
   "i": 37,
   "t": 155.626,
   "ja": "そんなものに縋り付きたいのか？",
   "zh": "你想依赖的就是这种东西吗？",
